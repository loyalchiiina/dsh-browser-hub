{
  "name": "dsh-browser-hub",
  "version": "0.2.8",
  "description": "侧边栏浏览器搜索引擎以及书签功能补丁插件（dsh-browser-hub）：给 DSH 自带「浏览器」Tab 增加搜索引擎选择、书签收藏、多级文件夹与导入 360/Chrome 书签 HTML。",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./icon": "./icon.svg",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "data/defaults.json",
    "docs",
    "screenshots.json",
    "icon.svg",
    "README.md",
    "locale/*.json"
  ],
  "icon": "./icon.svg",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "dsh-better-sidebar",
    "bookmarks",
    "browser"
  ],
  "license": "MIT",
  "dsh": {
    "labels": ["remote-access"],
    "capabilities": ["network:egress", "network:ingress"],
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    },
    "manifestVersion": 1
  },
  "peerDependencies": {
    "dsh-better-sidebar": ">=0.20.0"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/loyalchiiina/dsh-browser-hub.git"
  },
  "homepage": "https://github.com/loyalchiiina/dsh-browser-hub#readme",
  "bugs": {
    "url": "https://github.com/loyalchiiina/dsh-browser-hub/issues"
  }
}
